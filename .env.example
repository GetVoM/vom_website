# Copy to .env.local and fill in. Never commit real values.
# Which ones go to Vercel (Production and Preview) and GitHub Actions is listed
# in docs/architecture.md.

# Supabase (posts, categories, authors, leads, admin login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: the import script, the backups, and saving leads (lib/leads/record.ts).
# Never give it a NEXT_PUBLIC_ name and never import it from a client component.
SUPABASE_SERVICE_ROLE_KEY=
# Backups only (pg_dump).
SUPABASE_DB_URL=

# Cloudflare R2 (media at media.getvom.com)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BACKUP_BUCKET=
MEDIA_BASE_URL=https://media.getvom.com

# Cloudflare Turnstile (public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead notification email (optional)
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
# A sender on a domain verified in Resend, e.g. "VoM website <leads@getvom.com>"
LEADS_FROM_EMAIL=

# The admin's address: one segment of lowercase letters, digits and hyphens.
# Empty means /admin. With a value, the admin is at /<ADMIN_PATH>/ and /admin is a 404.
# Private: set it at build time too (Vercel: Production and Preview).
ADMIN_PATH=

# /api/revalidate
REVALIDATE_SECRET=

# Google Tag Manager loads on the production deployment only (lib/seo/tags.ts).
# GTM_ON=1 loads it elsewhere, for testing with the ad endpoints blocked:
# its conversion triggers fire on any host.
# GTM_ON=

# WordPress import (read-only)
WP_BASE_URL=https://getvom.com
WP_USER=
WP_APP_PASSWORD=
