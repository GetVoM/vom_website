# Copy to .env.local and fill in. Never commit real values.
# Which ones go to Vercel (Production and Preview) and GitHub Actions is listed
# in docs/architecture.md.

# Supabase (posts, categories, authors, leads, admin login)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Import script and backups only. Never used by the app.
SUPABASE_SERVICE_ROLE_KEY=
# Backups only (pg_dump).
SUPABASE_DB_URL=

# Cloudflare R2 (media at media.getvom.com)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BACKUP_BUCKET=
MEDIA_BASE_URL=https://media.getvom.com

# Cloudflare Turnstile (public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead notification email (optional)
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=

# /api/revalidate
REVALIDATE_SECRET=

# WordPress import (read-only)
WP_BASE_URL=https://getvom.com
WP_USER=
WP_APP_PASSWORD=
