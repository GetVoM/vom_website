{"nodes": [{"id": "docs_architecture", "label": "Architecture decisions", "file_type": "document", "source_file": "docs/architecture.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_static_rendering", "label": "Rendering: fully static, revalidated by tag (\u00a71)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected request-time rendering behind a CDN: it costs Core Web Vitals and complicates hreflang-correct caching."}, {"id": "docs_architecture_locale_routing", "label": "Locales: Arabic at /, English at /en, no automatic redirects (\u00a72)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected two route trees (duplicated layouts, no shared root param) and proxy locale detection (hides pages from crawlers, splits caches)."}, {"id": "docs_architecture_url_preservation", "label": "URLs: preserve first, restructure later (\u00a73)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected moving posts to /blog/<slug>/ at launch: about 230 redirects and ranking volatility during a migration that already changes platform, design and markup."}, {"id": "docs_architecture_catch_all_route", "label": "Catch-all route app/[lang]/[...slug]", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_campaign_layout", "label": "Campaign root layout app/(campaigns)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No header, nav or footer; Arabic only; noindex, follow; excluded from the Arabic rewrite via ARABIC_PATH."}, {"id": "docs_architecture_content_layer", "label": "Content layer lib/content/ (one interface, swappable storage) (\u00a74)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MDX first because the owner deferred the CMS: no service, Git history, editable by Claude Code. Posts and news moved to Supabase on 2026-11-11; guides, accounting guide and tools stay MDX. Long-form pages exceed the 100 KB HTML budget because the RSC payload repeats the body."}, {"id": "docs_architecture_metadata_jsonld", "label": "Metadata and JSON-LD from one source lib/seo/ (\u00a75)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_fonts", "label": "Fonts: Effra via next/font/local (\u00a76)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_images_media", "label": "Images and media: next/image, R2 at media.getvom.com (\u00a77)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_analytics", "label": "Analytics and third parties: GTM on production only (\u00a78)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The GTM container's conversion triggers have no hostname condition, so a form sent from a preview or laptop would reach Google Ads, GA4, Meta and Stape as a real lead (happened on 2026-11-12)."}, {"id": "docs_architecture_gtm_container", "label": "Google Tag Manager container GTM-PS28X6L", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_elementor_form_success_event", "label": "elementor_form_success GTM event contract", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New forms push the old Elementor events (form_name, form_id) so existing GTM triggers keep working; only the digital-ads form id c8749cd has conversion triggers today."}, {"id": "docs_architecture_posthog_events", "label": "PostHog custom events (lib/analytics/events.ts, delegated Tracker)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-rendered markup ships no tracking code; one delegated listener names clicks; nothing typed into a form or calculator is an event property."}, {"id": "docs_architecture_seo_audit_fixes", "label": "SEO audit fixes 2026-11-17 (410s, sitemap index, RSS, llms.txt)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_lead_forms", "label": "Forms and conversion: submitLead Server Action and LeadForm (\u00a79)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The insert comes before the optional Resend email, so an email failure never loses a lead."}, {"id": "docs_architecture_saudi_mobile_normalisation", "label": "Saudi mobile normalisation (lib/leads/phone.ts, 05XXXXXXXX)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_security_headers", "label": "Static CSP and security headers (\u00a710)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No nonces because a nonce CSP forces dynamic rendering, so scripts and styles allow 'unsafe-inline'."}, {"id": "docs_architecture_testing_gates", "label": "Testing and quality gates (\u00a711)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_check_urls", "label": "pnpm check:urls URL contract checker (scripts/check-blog-urls.mjs)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_hosting", "label": "Hosting: Vercel, DNS cut-over (\u00a712)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WordPress kept reachable on a temporary hostname for two weeks; the SEO strategy says retire WordPress after three months."}, {"id": "docs_architecture_backend_services", "label": "Backend services: Supabase, R2, Turnstile, admin (\u00a713)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_supabase_project", "label": "Supabase project vom-website (eu-central-1, RLS on)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_cloudflare_r2", "label": "Cloudflare R2 (media.getvom.com, backup bucket)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_turnstile", "label": "Cloudflare Turnstile on public forms", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_admin", "label": "Admin at /admin (ADMIN_PATH, Supabase Auth)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every page and action checks the session and the admins list on the server; proxy.ts only refreshes the session for browsers carrying the vom_admin cookie."}, {"id": "docs_architecture_open_items", "label": "Architecture open items (author bios, Turnstile keys, Effra licence)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_architecture", "target": "docs_architecture_static_rendering", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture", "target": "docs_architecture_locale_routing", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture", "target": "docs_architecture_url_preservation", "relation": "conceptually_re